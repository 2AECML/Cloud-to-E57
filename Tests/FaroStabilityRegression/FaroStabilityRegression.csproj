<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable><PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="EasyTry"><HintPath>../../EasyTry/bin/x64/Release/net8.0-windows-tasklist/EasyTry.dll</HintPath></Reference>
    <WorkerAsset Include="../../EasyTry/bin/x64/Release/net8.0-windows-tasklist/*.dll;../../EasyTry/bin/x64/Release/net8.0-windows-tasklist/*.json;../../EasyTry/bin/x64/Release/net8.0-windows-tasklist/*.ini;../../EasyTry/bin/x64/Release/net8.0-windows-tasklist/EasyTry.exe" />
    <WorkerAsset Include="../../Native/.build-e57/bridge-build/Release/EasyTryE57Native.dll"><TargetName>EasyTryE57Readback.dll</TargetName></WorkerAsset>
  </ItemGroup>
  <Target Name="CopyWorkerRuntime" AfterTargets="Build">
    <Copy SourceFiles="@(WorkerAsset)" DestinationFiles="@(WorkerAsset->'$(OutDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'%(WorkerAsset.TargetName)' == ''" />
    <Copy SourceFiles="@(WorkerAsset)" DestinationFiles="@(WorkerAsset->'$(OutDir)%(TargetName)')" SkipUnchangedFiles="true" Condition="'%(WorkerAsset.TargetName)' != ''" />
  </Target>
</Project>
